{
  "name": "@thirdlight/project-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thirdlight project model: strict parsing, validation, normalization, canonical serialization and migration of project data, the component registry, limits, and the pure graph, material and kit helpers other packages share. Pure data and logic; no I/O, no three.js.",
  "exports": {
    ".": "./src/index.ts",
    "./png": "./src/png-decode.ts",
    "./limits": "./src/limits.ts",
    "./input": "./src/input.ts",
    "./graph": "./src/graph.ts",
    "./animator-graph": "./src/animator-graph.ts",
    "./effects": "./src/effects.ts",
    "./effect-graph-kinds": "./src/effect-graph-kinds.ts",
    "./texture-slots": "./src/texture-slots.ts",
    "./trim-sheet": "./src/trim-sheet.ts",
    "./material-reads": "./src/material-reads.ts",
    "./material-schema": "./src/material-schema.ts",
    "./meshopt": "./src/meshopt.ts",
    "./decal-clip-glb": "./src/decal-clip-glb.ts",
    "./layered-surface": "./src/layered-surface.ts",
    "./arch-style-rows": "./src/arch-style-rows.ts",
    "./kits": "./src/kits.ts",
    "./kit-checks": "./src/kit-checks.ts",
    "./model-occluders": "./src/model-occluders.ts",
    "./repeated-rows": "./src/repeated-rows.ts",
    "./plane-lock": "./src/plane-lock.ts",
    "./shape-2d-3d": "./src/shape-2d-3d.ts",
    "./content-helpers": "./src/content-helpers.ts",
    "./request-id": "./src/request-id.ts",
    "./authoring-rules": "./src/authoring-rules.ts"
  },
  "dependencies": {
    "@thirdlight/shared": "0.1.0"
  },
  "sideEffects": false
}
