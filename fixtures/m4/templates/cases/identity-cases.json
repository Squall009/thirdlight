  "description": "The identity-independence cases (templates.md §14.3; C04/C05). The checker re-derives: (a) two creations from the same template (different projectIds) share the internal IDs (deterministic replay) and differ in every identity-bearing field; (b) the v2 replacement identity (changed game text ⇒ new digests) and the old-project-unchanged invariant.",
  "twoCreations": {
    "sameTemplate": {
      "templateId": "platformer-starter",
      "version": 1,
      "contentDigest": "d9f1a764c98ca09f57f57bee4fa782f3b8eabc3d673632f837428a1885967d34"
    },
    "creationA": {
      "projectId": "starter-0001",
      "name": "My Platformer"
    },
    "creationB": {
      "projectId": "starter-0002",
      "name": "Second Platformer"
    },
    "invariants": {
      "internalEntityIds": "equal (the deterministic <kind>-NNNN allocations over the identical base scene + recipe — project-scoped reuse, m4-plan §2.1)",
      "internalAssetIds": "equal (the recipe-authored assetIds)",
      "distinct": [
        "projectId",
        "manifest.id",
        "manifest.name",
        "manifest.createdAt (each creation time)",
        "envelope.projectId",
        "ownership record (claim)"
      ],
      "crossProjectReference": "not expressible (the accepted project-scoped ID model)"
    },
