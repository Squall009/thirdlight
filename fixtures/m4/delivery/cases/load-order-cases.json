  "previewSequence": [
    {
      "step": 1,
      "event": "shell",
      "detail": "GET /play/<playSessionId>?content=<contentId> → page config v2 (authoringOrigin, playSessionId, contentId, manifestPath)"
    },
    {
      "step": 2,
      "event": "tl.handshake",
      "detail": "editor → preview: nonce, demo, bridgeVersion 2, contentId, buildId (= manifest.buildId)"
    },
    {
      "step": 3,
      "event": "tl.handshake.ack",
      "detail": "preview → editor: nonce echoed (origin/source/playSessionId verified first) — D-63-5 repair point"
    },
    {
      "step": 4,
      "event": "tl.playContent.expect + tl.snapshot",
      "detail": "editor → preview after the ack: expect (contentId, buildId) and the runtime.md §2 document WITH the v3 game field"
    },
    {
      "step": 5,
      "event": "manifest-read",
      "detail": "fetch(\"./manifest.json\"); validate type gate, buildId == expected, snapshot.scene rehash → sceneDigest, snapshot.game rehash → gameDigest, snapshotId/revision match; tl.load.progress phase \"manifest\""
    },
    {
      "step": 6,
      "event": "asset-reads",
      "detail": "one read per unique declared asset path (content/sha256/<digest>), re-hash vs sourceDigest; tl.load.progress phase \"assets\""
    },
    {
      "step": 7,
      "event": "runtime-instantiate",
      "detail": "instantiateRuntime({ snapshot (incl. game), settings = manifest.settings (resolved), M3 module set })"
    },
    {
      "step": 8,
      "event": "adapter+models",
      "detail": "createSceneAdapter(canvas, { runtime, snapshot, models: { assets, animation: manifest.media.animation, resolveBytes } }) — model prepares start (async, cancellable)"
    },
    {
      "step": 9,
      "event": "host-mount",
      "detail": "createGameHost + mount(); run = awaitingStart; the menu channel is live (start/replay/mute serviced between frames)"
    },
    {
      "step": 10,
      "event": "prepares-settle",
      "detail": "all model prepares ready (or a hard failure per L1–L5/L9)"
    },
    {
      "step": 11,
      "event": "tl.ready",
      "detail": "preview → editor: the real identity tuple — D-63-6 repair point",
      "readyTuple": {
        "snapshotId": "m4-delivery-case@r7",
        "revision": 7,
        "buildId": "35cbb4783f31f9c756ce064fc9bdeed54a1d2ec34bf4eb5a23b1d2502f373991",
        "contentDigest": "09deb304299d49d77207f8662663428bc580df1b8c3ee995775b9ad2e83c794e",
        "stepIndex": 12
      }
    },
    {
      "step": 12,
      "event": "play.preview.ready",
      "detail": "editor → backend WS (the send path — D-63-4 repair point); the backend marks the play presented before the 15 s bound"
    }
  ],
  "failureInjection": [
    {
      "id": "L1-buildId-mismatch",
      "phase": "manifest",
      "change": "the handshake carries a different buildId than the served manifest",
      "fetches": 1,
      "outcome": {
        "message": "tl.error",
        "phase": "manifest",
        "code": "play_content_not_ready"
      },
      "after": "no asset read, no runtime, no tl.ready; the editor reports the truthful failure and the play is never presented (preview_timeout at +15 s if unhandled)"
    },
    {
      "id": "L1b-sceneDigest-mismatch",
      "phase": "manifest",
      "change": "the snapshot scene re-hashes to a value ≠ manifest.sceneDigest",
      "fetches": 1,
      "outcome": {
        "message": "tl.error",
        "phase": "manifest",
        "code": "play_content_not_ready"
      },
      "after": "same as L1 (the snapshot is not this capture)"
    },
    {
      "id": "L1c-gameDigest-mismatch",
      "phase": "manifest",
      "change": "the snapshot game re-hashes to a value ≠ manifest.gameDigest",
      "fetches": 1,
      "outcome": {
        "message": "tl.error",
        "phase": "manifest",
        "code": "play_content_not_ready"
      },
      "after": "same as L1 (the D-63-9 digest gate — the transported game is digest-bound)"
    },
    {
      "id": "L2-digest-mismatch",
      "phase": "assets",
      "change": "a declared asset read returns bytes whose sha256 ≠ the manifest row sourceDigest",
      "fetches": 2,
      "outcome": {
        "message": "tl.error",
        "phase": "assets",
        "code": "asset_corrupt"
      },
      "after": "no runtime; no partial scene; never a silent retry against another path"
    },
    {
      "id": "L4-extension-unsupported",
      "phase": "assets",
      "change": "the verified bytes require a GLB extension the visual profile cannot honor",
      "fetches": 2,
      "outcome": {
        "message": "tl.error",
        "phase": "assets",
        "code": "asset_extension_unsupported"
      },
      "after": "no runtime (hard, L4)"
    },
    {
      "id": "L5-clip-invalid",
      "phase": "assets",
      "change": "the prepared resource carries a structurally invalid animation clip",
      "fetches": 2,
      "outcome": {
        "message": "tl.error",
        "phase": "assets",
        "code": "asset_clip_invalid"
      },
      "after": "no runtime (hard, L5)"
    },
    {
      "id": "L6-unresolved-mapping",
      "phase": "prepares-settle",
      "change": "the committed roles do not satisfy the loaded clips (stage 5–6 re-check)",
      "fetches": 2,
      "outcome": {
        "message": "no tl.error; the model renders statically at its committed transform; one bounded diagnostic (animation_role_unresolved); the run proceeds",
        "ready": true
      },
      "after": "tl.ready is posted (the mount succeeded); gameplay runs with the static model (R6)"
    },
    {
      "id": "L9-cancel-on-stop",
      "phase": "prepares-settle",
      "change": "the play stops (editor removes the frame / locator expiry) while a prepare is in flight",
      "fetches": 2,
      "outcome": {
        "message": "the pending handle is cancelled; it resolves ok:false (asset_load_cancelled) and its late completion is discarded and released — never applied to the scene",
        "ready": false
      },
      "after": "the host/adapter dispose idempotently; a repeated dispose returns alreadyDisposed (no double free)"
    }
  ],
  "pinnedReimport": {
    "rule": "A reimport of an asset during an active play publishes a new version into the authoring project; the active preview keeps its PINNED snapshot and content (accepted §19.2/§19.3 pinning; delivery.md §2.6). The new version is visible only to a NEW play (new snapshotId/contentId); the old locator serves the same immutable bytes.",
    "cases": [
      {
        "phase": "during-active-play",
        "change": "publishAsset reimport of asset-runner (authoring revision advances)",
        "activePlay": {
          "snapshotId": "m4-delivery-case@r7",
          "contentId": "unchanged",
          "buildId": "35cbb4783f31f9c756ce064fc9bdeed54a1d2ec34bf4eb5a23b1d2502f373991"
        },
        "authoring": {
          "revision": 8,
          "currentVersion": 2
        },
        "after": "the active play is unaffected (no in-flight re-point); the new play captures r8 with the new version"
      },
      {
        "phase": "old-locator",
        "change": "a fetch of the old contentId during its remaining TTL",
        "after": "the same immutable bytes (Cache-Control: private, immutable; ETag = digest) — never newer content"
      }
    ]
  },
  "exportSequence": [
    {
      "step": 1,
      "event": "manifest+scene-read",
      "detail": "fetch(\"./manifest.json\") + fetch(\"./scene.json\") (relative, digest-verified — the accepted C36-1 row); the manifest identity gates (buildId/sceneDigest/gameDigest) pass against the scene.json bytes"
    },
    {
      "step": 2,
      "event": "asset-reads",
      "detail": "one relative read per unique declared asset path, re-hashed"
    },
    {
      "step": 3,
      "event": "runtime+adapter+host",
      "detail": "instantiateRuntime (settings = manifest.settings) + createSceneAdapter with the models block + createGameHost + mount() → awaitingStart title screen"
    },
    {
      "step": 4,
      "event": "ready",
      "detail": "ready means the title screen loaded (not gameplay started); no bridge, no presented state, no authoring call (the backend may be unreachable)"
    }
  ]
}
