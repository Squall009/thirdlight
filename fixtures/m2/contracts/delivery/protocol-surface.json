  "bridgeMessages": [
    {
      "name": "tl.handshake",
      "version": 2,
      "direction": "editor->preview",
      "maxBytes": 4096,
      "carriesBinary": false,
      "fields": [
        "v",
        "bridgeVersion",
        "playSessionId",
        "nonce",
        "demo",
        "contentId",
        "buildId"
      ]
    },
    {
      "name": "tl.playContent.expect",
      "version": 2,
      "direction": "editor->preview",
      "maxBytes": 4096,
      "carriesBinary": false,
      "fields": [
        "v",
        "playSessionId",
        "contentId",
        "buildId"
      ]
    },
    {
      "name": "tl.input.request",
      "version": 2,
      "direction": "editor->preview",
      "maxBytes": 16384,
      "carriesBinary": false,
      "fields": [
        "v",
        "playSessionId",
        "requestId",
        "frames"
      ]
    },
    {
      "name": "tl.load.progress",
      "version": 2,
      "direction": "preview->editor",
      "maxBytes": 1024,
      "carriesBinary": false,
      "fields": [
        "v",
        "playSessionId",
        "phase",
        "loadedBytes",
        "totalBytes"
      ]
    },
    {
      "name": "tl.input.result",
      "version": 2,
      "direction": "preview->editor",
      "maxBytes": 4096,
      "carriesBinary": false,
      "fields": [
        "v",
        "playSessionId",
        "requestId",
        "ok",
        "appliedFromStep",
        "appliedToStep"
      ]
    },
    {
      "name": "tl.ready",
      "version": 2,
      "direction": "preview->editor",
      "maxBytes": 4096,
      "carriesBinary": false,
      "fields": [
        "v",
        "playSessionId",
        "snapshotId",
        "revision",
        "buildId",
        "contentDigest",
        "stepIndex"
      ]
    },
    {
      "name": "tl.error",
      "version": 2,
      "direction": "preview->editor",
      "maxBytes": 4096,
      "carriesBinary": false,
      "fields": [
        "v",
        "playSessionId",
        "code",
        "phase",
        "message"
      ]
    },
    {
      "name": "tl.snapshot",
      "version": 2,
      "direction": "editor->preview",
      "maxBytes": 1048576,
      "carriesBinary": false,
      "fields": [
        "v",
        "playSessionId",
        "nonce",
        "snapshot"
      ]
    }
  ],
  "forbiddenBinaryCarriers": [
    "tl.snapshot",
    "mutation.applied",
    "full-state",
    "change"
  ]
