  "pins": [
    {
      "file": "docs/planning/m2-contracts/input.md",
      "section": "## 2. `ActionFrame` (strict shape)"
    },
    {
      "file": "docs/planning/m2-contracts/input.md",
      "section": "### 3.2 Press latch — exactly one edge per executed step"
    },
    {
      "file": "docs/planning/m2-contracts/input.md",
      "section": "### 4.2 Gamepad dead zone and rescaling"
    },
    {
      "file": "docs/planning/m2-contracts/input.md",
      "section": "### 4.3 Simultaneous-source arbitration (deterministic, no summation)"
    },
    {
      "file": "docs/planning/m2-contracts/input.md",
      "section": "### 5.3 Suspension: focus loss, hidden tab, page hide"
    },
    {
      "file": "docs/planning/m2-contracts/input.md",
      "section": "### 5.4 Hot disconnect"
    }
  ],
