  "sequenceCases": [
    {
      "caseId": "Q1-tap-between-steps",
      "title": "a tap that begins and ends between two samples produces exactly one pressed",
      "events": [
        {
          "atStep": 13.2,
          "kind": "down"
        },
        {
          "atStep": 13.8,
          "kind": "up"
        }
      ],
      "sampleSteps": [
        12,
        13,
        14,
        15
      ],
      "expectPressedCount": 1,
      "expectFrames": [
        {
          "stepIndex": 12,
          "moveX": 0,
          "jump": "none"
        },
        {
          "stepIndex": 13,
          "moveX": 0,
          "jump": "none"
        },
        {
          "stepIndex": 14,
          "moveX": 0,
          "jump": "pressed"
        },
        {
          "stepIndex": 15,
          "moveX": 0,
          "jump": "released"
        }
      ],
      "expectPressedCountActual": 1,
      "expectPressedCountMatches": true
    },
    {
      "caseId": "Q2-hold-and-release",
      "title": "a held button is pressed once, then held, then released once",
      "events": [
        {
          "atStep": 12,
          "kind": "down"
        },
        {
          "atStep": 16,
          "kind": "up"
        }
      ],
      "sampleSteps": [
        12,
        13,
        14,
        15,
        16,
        17
      ],
      "expectPressedCount": 1,
      "expectFrames": [
        {
          "stepIndex": 12,
          "moveX": 0,
          "jump": "pressed"
        },
        {
          "stepIndex": 13,
          "moveX": 0,
          "jump": "held"
        },
        {
          "stepIndex": 14,
          "moveX": 0,
          "jump": "held"
        },
        {
          "stepIndex": 15,
          "moveX": 0,
          "jump": "held"
        },
        {
          "stepIndex": 16,
          "moveX": 0,
          "jump": "released"
        },
        {
          "stepIndex": 17,
          "moveX": 0,
          "jump": "none"
        }
      ],
      "expectPressedCountActual": 1,
      "expectPressedCountMatches": true
    },
    {
      "caseId": "Q3-double-tap-coalesced",
      "title": "two taps inside one fixed step coalesce into one pressed frame (single latch)",
      "events": [
        {
          "atStep": 13.1,
          "kind": "down"
        },
        {
          "atStep": 13.2,
          "kind": "up"
        },
        {
          "atStep": 13.3,
          "kind": "down"
        },
        {
          "atStep": 13.4,
          "kind": "up"
        }
      ],
      "sampleSteps": [
        12,
        13,
        14
      ],
      "expectPressedCount": 1,
      "expectFrames": [
        {
          "stepIndex": 12,
          "moveX": 0,
          "jump": "none"
        },
        {
          "stepIndex": 13,
          "moveX": 0,
          "jump": "none"
        },
        {
          "stepIndex": 14,
          "moveX": 0,
          "jump": "pressed"
        }
      ],
      "expectPressedCountActual": 1,
      "expectPressedCountMatches": true
    },
    {
      "caseId": "Q4-focus-loss-resume",
      "title": "after a suspension a still-held jump yields held (never pressed) until it is released",
      "events": [
        {
          "atStep": 12,
          "kind": "down"
        },
        {
          "atStep": 15,
          "kind": "up"
        },
        {
          "atStep": 16,
          "kind": "down"
        }
      ],
      "sampleSteps": [
        12,
        13,
        14,
        15,
        16,
        17
      ],
      "expectPressedCount": 2,
      "suspendBeforeStep": 13,
      "expectFrames": [
        {
          "stepIndex": 12,
          "moveX": 0,
          "jump": "pressed"
        },
        {
          "stepIndex": 13,
          "moveX": 0,
          "jump": "held"
        },
        {
          "stepIndex": 14,
          "moveX": 0,
          "jump": "held"
        },
        {
          "stepIndex": 15,
          "moveX": 0,
          "jump": "none"
        },
        {
          "stepIndex": 16,
          "moveX": 0,
          "jump": "pressed"
        },
        {
          "stepIndex": 17,
          "moveX": 0,
          "jump": "held"
        }
      ],
      "expectPressedCountActual": 2,
      "expectPressedCountMatches": true
    },
    {
      "caseId": "Q5-hidden-tab-resume",
      "title": "a hidden tab suspends and clears the latch; the pre-hidden tap is never replayed",
      "events": [
        {
          "atStep": 12.5,
          "kind": "down"
        },
        {
          "atStep": 13,
          "kind": "up"
        }
      ],
      "sampleSteps": [
        12,
        13,
        14,
        15
      ],
      "expectPressedCount": 0,
      "suspendBeforeStep": 13,
      "expectFrames": [
        {
          "stepIndex": 12,
          "moveX": 0,
          "jump": "none"
        },
        {
          "stepIndex": 13,
          "moveX": 0,
          "jump": "none"
        },
        {
          "stepIndex": 14,
          "moveX": 0,
          "jump": "none"
        },
        {
          "stepIndex": 15,
          "moveX": 0,
          "jump": "none"
        }
      ],
      "expectPressedCountActual": 0,
      "expectPressedCountMatches": true
    }
  ],
