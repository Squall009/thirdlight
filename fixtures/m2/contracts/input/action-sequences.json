      "code": "input_frame_invalid",
      "field": "device"
    },
    {
      "caseId": "I8-broken-phase-chain",
      "frames": [
        {
          "stepIndex": 12,
          "moveX": 0,
          "jump": "held"
        }
      ],
      "code": "input_frame_invalid",
      "field": "jump"
    }
  ],
  "tolerances": {
    "sameBuildSameEngine": "exact (bit-identical)",
    "sameBuildRepeatedSessionM": 0.000001,
    "sameSourcesDifferentEngineM": 0.001,
    "crossPlatformBitExact": false
  }
}
