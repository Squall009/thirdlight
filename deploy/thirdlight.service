# Thirdlight backend as a systemd service (process-level in the LXC).
# Install: sudo cp deploy/thirdlight.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now thirdlight
# Adjust --host to the address browsers will use; the backend allows only that exact origin.
[Unit]
Description=Thirdlight game editor backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dadmin
Group=dadmin
WorkingDirectory=/home/dadmin/projects/thirdlight
ExecStart=/usr/bin/node /home/dadmin/projects/thirdlight/tools/start.mjs --host 10.0.10.223 --data-root /home/dadmin/thirdlight --origin https://thirdlight.turnkeydata.net --preview-origin https://thirdlight-play.turnkeydata.net --trusted-networks 10.0.0.0/16,127.0.0.1 --trusted-proxies 10.0.30.201
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=NODE_ENV=production
# Phase 11: MCP play without a browser opens a headless editor (Chromium from
# playwright-core). This LXC has no browser libraries: point at an extracted
# tree (delete the line on hosts with `npx playwright install-deps chromium`).
Environment=THIRDLIGHT_BROWSER_LIBS=/home/dadmin/projects/visionary/.browser-libs/root/usr/lib/x86_64-linux-gnu
# Phase 9.6: final light bakes run Blender Cycles on the RTX 5090 workstation
# (ssh/scp as this user; delete both lines to disable the final bake).
Environment=THIRDLIGHT_BAKE_HOST=dadmin@10.0.10.145
Environment=THIRDLIGHT_BAKE_BLENDER=/opt/blender/5.2.2/blender

[Install]
WantedBy=multi-user.target
